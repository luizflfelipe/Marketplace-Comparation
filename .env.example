# Variáveis de Ambiente Necessárias para Rodar Localmente e em VPS

# NODE_ENV
# --------
# Use "development" para rodar localmente com logs completos.
# Use "production" quando for publicar na VPS.
NODE_ENV=development

# PORT
# ----
# Opcional. Porta onde o servidor vai rodar. Se omitido, roda na 3000 por padrão.
PORT=3000

# ALLOWED_ORIGIN 
# --------------
# Define as origens permitidas (CORS) para acessar o servidor.
# Localmente: http://localhost:3000
# VPS: O domínio definitivo, ex: https://minhaloja-precos.com.br
ALLOWED_ORIGIN=http://localhost:3000

# SERPAPI_KEY (Obrigatório)
# -------------------------
# Chave da API do SerpAPI. Exigido para buscas na Web (Shopping/Lens)
SERPAPI_KEY=sua_chave_serpapi_aqui

# GEMINI_API_KEY (Obrigatório)
# ----------------------------
# Chave da API Gemini da Google, usada para Insights Preditivos e de Estratégia
GEMINI_API_KEY=sua_chave_gemini_aqui
